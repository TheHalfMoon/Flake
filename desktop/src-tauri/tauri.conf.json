{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flake",
  "version": "0.0.1-phase-t",
  "identifier": "app.flake.desktop.phase-t",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Flake (Phase T -- experimental, not a product)",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OptimizationHints,MediaRouter,EdgeFeedback,msEdgeTelemetry,PrivateNetworkAccessSendPreflights --disable-background-networking --disable-component-update --disable-breakpad --disable-domain-reliability --disable-client-side-phishing-detection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
